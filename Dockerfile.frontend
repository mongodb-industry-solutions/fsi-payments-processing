FROM node:22-alpine
WORKDIR /app

# Copy package files first for better caching
COPY frontend/package*.json ./

# Use legacy-peer-deps for Leafy Green UI components
RUN npm install --legacy-peer-deps

# Copy all frontend files INCLUDING configs
COPY frontend/ ./

# Build the application
RUN npm run build

# Kanopy requires port 8080
ENV PORT=8080
EXPOSE 8080

# Start Next.js on port 8080
CMD ["npm", "start", "--", "-p", "8080"]
