FROM node:22-alpine
WORKDIR /app

# Copy package files first for better caching
COPY frontend/package*.json ./

# Use legacy-peer-deps for Leafy Green UI components
RUN npm install --legacy-peer-deps

# Copy all frontend files INCLUDING configs
COPY frontend/ ./

# Browser-facing URL of the standalone BIAN Data Model Explorer. Baked at
# build time because pages are statically prerendered — a runtime env var
# would not reach the prerendered HTML. Per-environment value comes from the
# kaniko build_args in .drone.yml; defaults to the deployed staging explorer
# so local builds link somewhere live without running bian-model locally.
ARG BIAN_MODEL_URL=https://leafy-bank-bian-model.industrysolutions.staging.corp.mongodb.com
ENV BIAN_MODEL_URL=$BIAN_MODEL_URL

# Build the application
RUN npm run build

# Kanopy requires port 8080
ENV PORT=8080
EXPOSE 8080

# Start Next.js on port 8080
CMD ["npm", "start", "--", "-p", "8080"]
