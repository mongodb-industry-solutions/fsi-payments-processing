FROM node:22-alpine
WORKDIR /app

# Copy package files and configs first for better caching
COPY frontend/package*.json ./
COPY frontend/jsconfig.json ./
COPY frontend/next.config.mjs ./

# Use legacy-peer-deps for Leafy Green UI components
RUN npm install --legacy-peer-deps

# Copy all frontend files
COPY frontend/ ./

# Build the application
RUN npm run build

# Kanopy requires port 8080
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
EXPOSE 8080

# Start Next.js on port 8080
CMD ["npm", "start"]