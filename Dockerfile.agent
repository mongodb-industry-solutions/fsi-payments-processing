FROM python:3.11-slim

WORKDIR /app

# Install uv for fast dependency management
RUN pip install uv

# Copy dependency files first for better caching
COPY backend/payment_agent/pyproject.toml ./
COPY backend/payment_agent/uv.lock ./

# Install dependencies
RUN uv sync --no-dev

# Copy application code
COPY backend/payment_agent/ ./

# Port 8002 for agent service (sidecar)
EXPOSE 8002

# CRITICAL: Must bind to 0.0.0.0 for sidecar communication
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]
