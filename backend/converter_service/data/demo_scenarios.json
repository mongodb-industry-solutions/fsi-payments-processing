                    "value": "840",
                    "label": "USD"
                  },
                  {
                    "value": "978",
                    "label": "EUR"
                  },
                  {
                    "value": "826",
                    "label": "GBP"
                  }
                ],
                "default": "840",
                "required": true
              },
              {
                "id": "merchant_name",
                "label": "Merchant Name",
                "type": "text",
                "placeholder": "STARBUCKS #12345",
                "required": true
              },
              {
                "id": "location",
                "label": "Transaction Location",
                "type": "text",
                "placeholder": "NEW YORK NY US",
                "required": true
              }
            ]
          },
          {
            "title": "Terminal Information",
            "fields": [
              {
                "id": "terminal_id",
                "label": "Terminal ID",
                "type": "text",
                "placeholder": "TERM0001",
                "required": true
              },
              {
                "id": "merchant_id",
                "label": "Merchant ID",
                "type": "text",
                "placeholder": "MERCH12345",
                "required": true
              }
            ]
          }
        ]
      },
