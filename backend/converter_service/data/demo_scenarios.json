                "pattern": "[0-9]{13,19}",
                "mask": true
              },
              {
                "id": "processing_code",
                "label": "Processing Code",
                "type": "text",
                "placeholder": "000000",
                "default": "000000",
                "required": true
              }
            ]
          },
          {
            "title": "Transaction Details",
            "fields": [
              {
                "id": "amount",
                "label": "Transaction Amount",
                "type": "number",
                "placeholder": "127.50",
                "required": true,
                "min": 0,
                "step": 0.01
              },
              {
                "id": "currency_code",
                "label": "Currency Code",
