{
  "payment_types": [
    {
      "id": "cross_border",
      "display_name": "🌍 Cross-Border Payment",
      "description": "Send money internationally to any country",
      "icon": "🌍",
      "source_format": "MT103",
      "target_format": "pacs.008",
      "message_template": "{1:F01${sender_bic}0000000000}{2:I103${receiver_bic}N}{3:{108:ILOVESEPA}}{4:\n:20:${reference}\n:23B:CRED\n:32A:${value_date}${currency}${amount}\n:50K:/${sender_account}\n${sender_name}\n${sender_address}\n:52A:${sender_bank_bic}\n:53A:${intermediary_bic}\n:59:/${beneficiary_account}\n${beneficiary_name}\n${beneficiary_address}\n:70:${remittance_info}\n:71A:SHA\n:72:${sender_to_receiver_info}\n-}",
      "form_schema": {
        "sections": [
          {
            "title": "Sender Information",
            "fields": [
              {
                "id": "sender_name",
                "label": "Your Name/Company",
                "type": "text",
                "placeholder": "ACME Technologies Inc",
                "required": true
              },
              {
                "id": "sender_account",
                "label": "Your Account Number",
                "type": "text",
                "placeholder": "US64209876543210987654",
                "required": true
              },
              {
                "id": "sender_address",
                "label": "Your Address",
                "type": "textarea",
                "placeholder": "1234 Innovation Drive\nSilicon Valley CA 94025\nUSA",
                "required": true
              },
              {
                "id": "sender_bic",
                "label": "Your Bank BIC",
                "type": "text",
                "placeholder": "CHASUS33XXXX",
                "required": true,
                "pattern": "[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?"
              }
            ]
          },
          {
            "title": "Recipient Information",
            "fields": [
              {
                "id": "beneficiary_name",
                "label": "Recipient Name/Company",
                "type": "text",
                "placeholder": "Global Supplies GmbH",
                "required": true
              },
              {
                "id": "beneficiary_account",
                "label": "Recipient IBAN/Account",
                "type": "text",
                "placeholder": "DE89370400440532013000",
                "required": true
              },
              {
                "id": "beneficiary_address",
                "label": "Recipient Address",
                "type": "textarea",
                "placeholder": "Industriestrasse 78\n60329 Frankfurt\nGermany",
                "required": true
              },
              {
                "id": "receiver_bic",
                "label": "Recipient Bank BIC",
                "type": "text",
                "placeholder": "DEUTDEFFXXX",
                "required": true
              }
            ]
          },
          {
            "title": "Payment Details",
            "fields": [
              {
                "id": "amount",
                "label": "Amount",
                "type": "number",
                "placeholder": "125750.50",
                "required": true,
                "min": 0,
                "step": 0.01
              },
              {
                "id": "currency",
                "label": "Currency",
                "type": "select",
                "options": [
                  "USD",
                  "EUR",
                  "GBP",
                  "JPY",
                  "CHF",
                  "CAD",
                  "AUD"
                ],
                "default": "USD",
                "required": true
              },
              {
                "id": "reference",
                "label": "Payment Reference",
                "type": "text",
                "placeholder": "PAY-2024-DEC-001",
                "required": true
              },
              {
                "id": "remittance_info",
                "label": "Payment Purpose",
                "type": "textarea",
                "placeholder": "Invoice INV-2024-3847 dated 15.11.2024\nPayment for electronic components",
                "required": false
              }
            ]
          }
        ]
      },
