{
  "_id": "MT103_to_pacs.008",
  "extract": {
    "20": ":20:([^\\n:]+)",
    "59": ":59:([^\\n]*(?:\\n(?!:)[^\\n]*)*)",
    "70": ":70:([\\s\\S]*?)(?=\\n:[0-9]|\\n-\\})",
    "23B": ":23B:([^\\n:]+)",
    "32A": ":32A:([^\\n:]+)",
    "50K": ":50K:([^\\n]*(?:\\n(?!:)[^\\n]*)*)",
    "52A": ":52A:([^\\n:]+)",
    "71A": ":71A:([^\\n:]+)"
  },
  "map": [
    {
      "from": "20",
      "to": "transaction_ref"
    },
    {
      "from": "23B",
      "to": "bank_operation_code"
    },
    {
      "from": "32A",
      "to": [
        "value_date",
        "currency",
        "amount"
      ],
      "split": [
        6,
        9
      ]
    },
    {
      "from": "50K",
      "to": [
        "debtor_account",
        "debtor_name",
        "debtor_address"
      ],
      "multiline": true
    },
    {
      "from": "52A",
      "to": "ordering_institution"
    },
    {
      "from": "59",
      "to": [
        "creditor_account",
        "creditor_name",
        "creditor_address"
      ],
      "multiline": true
    },
    {
      "from": "70",
      "to": [
        "payment_purpose",
        "invoice_number",
        "details"
      ],
      "ai": "remittance",
      "patterns": {
        "payment_purpose": {
          "regex": "^(INVOICE|PAYMENT|CONTRACT|ORDER|TRANSFER|SALARY|DIVIDEND|FEE)",
          "group": 1,
          "default": "PAYMENT"
        },
        "invoice_number": {
          "regex": "([A-Z]{2,}-[A-Z0-9-]+-\\d{2,}|INV-[A-Z0-9-]+|REF[:\\s]*[A-Z0-9-]+)",
          "group": 1,
          "default": ""
        },
        "details": {
          "join_lines": ". ",
          "strip": true
        }
      }
    },
    {
      "from": "71A",
      "to": "charges_code"
    }
  ],
  "output": {
    "transaction_ref": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.PmtId.InstrId",
    "bank_operation_code": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.PmtTpInf.SvcLvl.Cd",
    "value_date": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.IntrBkSttlmDt",
    "currency": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.IntrBkSttlmAmt.@Ccy",
    "amount": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.IntrBkSttlmAmt.#text",
    "debtor_account": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.Dbtr.Id.OrgId.Othr.Id",
    "debtor_name": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.Dbtr.Nm",
    "debtor_address": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.Dbtr.PstlAdr.AdrLine",
    "ordering_institution": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.InstgAgt.FinInstnId.BICFI",
    "creditor_account": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.Cdtr.Id.OrgId.Othr.Id",
    "creditor_name": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.Cdtr.Nm",
    "creditor_address": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.Cdtr.PstlAdr.AdrLine",
    "payment_purpose": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.RmtInf.Strd.RfrdDocInf.Tp.CdOrPrtry.Prtry",
    "invoice_number": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.RmtInf.Strd.RfrdDocInf.Nb",
    "details": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.RmtInf.Ustrd",
    "charges_code": "Document.FIToFICstmrCdtTrf.CdtTrfTxInf.ChrgBr"
  }
